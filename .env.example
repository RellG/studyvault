STUDYVAULT_PORT=8420
# the Pi's LAN address; the app is published on this IP only
STUDYVAULT_LAN_IP=192.168.1.50
STUDYVAULT_PASSWORD=change-me
STUDYVAULT_SECRET=generate-with-openssl-rand-hex-32
STUDYVAULT_TZ=America/New_York
# anthropic | google | empty = AI features hidden
AI_PROVIDER=
# your provider's model id; never hardcoded in the app
AI_MODEL=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AI_MAX_OUTPUT_TOKENS=2048
# rsync destination for nightly backups, e.g. user@host:/path/studyvault or /mnt/usb/studyvault
BACKUP_TARGET=
